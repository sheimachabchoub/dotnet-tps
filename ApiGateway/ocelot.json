      "UpstreamHttpMethod": ["Get", "Post"]
    },
    {
      "DownstreamPathTemplate": "/api/Orders/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 5065 }],
      "UpstreamPathTemplate": "/apigateway/Orders/{id}",
      "UpstreamHttpMethod": ["Get", "Put"]
    }
  ],
